// Schema thiết kế của hr-manager, PostgreSQL (ADR-0009).
// Nguồn: entity và luật trong docs/analysis/domain.md; quy ước trong docs/design/data.md.
// Migration đầu tiên viết từ file này. Có migration rồi thì migration là nguồn chính; PR đổi schema sửa cả file này.
// DBML không biểu diễn được exclusion constraint, CHECK và trigger: các luật đó ghi trong Note của bảng,
// và có dòng tương ứng ở mục Rules enforced in data của data.md.

Project hr_manager {
  database_type: 'PostgreSQL'
  Note: 'Mọi bảng có created_at, updated_at timestamptz; bỏ khỏi file này cho gọn, trừ bảng chỉ ghi thêm.'
}

// ---------------------------------------------------------------- M1: tổ chức và nhân sự

Table employees {
  id uuid [pk]
  employee_code text [not null, unique, note: 'Không đổi (BR-015)']
  full_name text [not null]
  date_of_birth date
  gender text
  national_id text [note: 'Số CCCD; unique khi chưa ẩn danh (BR-022). Nhạy cảm']
  permanent_address text
  current_address text
  personal_phone text
  personal_email text
  work_phone text
  work_email text
  bank_name text
  bank_account_no text [note: 'Nhạy cảm; xóa theo BR-140']
  emergency_contact_name text
  emergency_contact_phone text
  status text [not null, note: 'upcoming | active | terminated | cancelled | anonymized']
  base_annual_leave_days smallint [not null, default: 12, note: 'M2: 12, 14 hoặc 16, chưa tính thâm niên (BR-048)']
  timeclock_code text [note: 'M3: unique giữa nhân viên đang làm (BR-072)']
  tax_code text [note: 'M4; nhạy cảm']
  social_insurance_no text [note: 'M4; nhạy cảm']
  income_commitment_year smallint [note: 'M4: năm có cam kết thu nhập']
  anonymized_at timestamptz [note: 'BR-141']
}

Table employment_periods {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  period daterange [not null, note: 'Ngày vào làm tới ngày làm việc cuối cùng; cận trên mở khi đang làm']
  termination_reason text
  Note: 'EXCLUDE (employee_id WITH =, period WITH &&): khoảng làm việc không chồng (BR-139)'
}

Table org_units {
  id uuid [pk]
  code text [not null, unique]
  established_on date [not null]
  dissolved_on date
  status text [not null, note: 'planned | active | dissolved']
  min_staff_ratio numeric(4,3) [note: 'M2: ngưỡng nhân sự riêng; trống thì dùng tham số min_staff_ratio (BR-146)']
}

Table org_unit_periods {
  id uuid [pk]
  org_unit_id uuid [not null, ref: > org_units.id]
  valid daterange [not null]
  name text [not null]
  parent_id uuid [ref: > org_units.id, note: 'Trống ở phòng ban gốc; đúng một gốc tại mỗi ngày (BR-007)']
  Note: 'EXCLUDE (org_unit_id WITH =, valid WITH &&). Cây không vòng (BR-008) kiểm ở domain'
}

Table positions {
  id uuid [pk]
  name text [not null, note: 'Unique không phân biệt hoa thường (BR-034): unique index trên lower(name)']
  is_active boolean [not null, default: true, note: 'Đã dùng thì chỉ ngừng dùng, không xóa (BR-035)']
}

Table assignments {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  valid daterange [not null]
  org_unit_id uuid [not null, ref: > org_units.id]
  position_id uuid [not null, ref: > positions.id]
  reason text
  Note: 'EXCLUDE (employee_id WITH =, valid WITH &&): không chồng (BR-016). Không hở và nằm trong khoảng làm việc: domain'
}

Table head_assignments {
  id uuid [pk]
  org_unit_id uuid [not null, ref: > org_units.id]
  employee_id uuid [not null, ref: > employees.id]
  valid daterange [not null]
  Note: 'EXCLUDE (org_unit_id WITH =, valid WITH &&): tối đa một trưởng mỗi ngày (BR-011)'
}

Table employment_contracts {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  contract_no text [not null, unique, note: 'BR-037']
  contract_type text [not null, note: 'probation | fixed_term | indefinite']
  probation_group text [note: 'Nhóm công việc khi thử việc (BR-028)']
  signed_on date [not null]
  valid daterange [not null, note: 'Cận trên mở với hợp đồng không xác định thời hạn']
  status text [not null, note: 'upcoming | active | expired | terminated']
  Note: 'EXCLUDE (employee_id WITH =, valid WITH &&): không chồng, kể cả thử việc (BR-025)'
}

Table user_accounts {
  id uuid [pk]
  employee_id uuid [not null, unique, ref: - employees.id]
  username text [not null, unique, note: 'Mã nhân viên (A-004)']
  password_hash text [not null, note: 'Argon2id (ADR-0010)']
  is_hr boolean [not null, default: false]
  must_change_password boolean [not null, default: true]
  failed_login_count smallint [not null, default: 0]
  throttled_until timestamptz [note: 'BR-003']
  status text [not null, note: 'active | throttled | locked']
  muted_signal_types text[] [not null, default: '{}', note: 'M5 (BR-178)']
  Note: 'Còn ít nhất một HR đang hoạt động (BR-004): kiểm ở domain, khóa các dòng is_hr khi đổi'
}

Table sessions {
  id uuid [pk]
  user_account_id uuid [not null, ref: > user_accounts.id]
  token_hash bytea [not null, unique, note: 'Cookie chỉ giữ token; DB giữ hash']
  created_at timestamptz [not null]
  last_seen_at timestamptz [not null]
  expires_at timestamptz [not null]
  Note: 'ADR-0010. Khóa tài khoản hoặc đổi vai trò thì xóa mọi phiên của tài khoản'
}

Table audit_entries {
  id bigint [pk, increment]
  occurred_at timestamptz [not null]
  actor_account_id uuid [ref: > user_accounts.id, note: 'Trống khi do Thời gian']
  object_type text [not null]
  object_id uuid [not null]
  action text [not null]
  before jsonb
  after jsonb
  reason text
  Note: 'Chỉ ghi thêm. Không chép giá trị đã xóa theo BR-140'
}

Table notifications {
  id uuid [pk]
  recipient_account_id uuid [not null, ref: > user_accounts.id]
  kind text [not null]
  body text [not null]
  object_type text
  object_id uuid
  sent_at timestamptz [not null]
  read_at timestamptz [note: 'BR-213']
}

Table parameters {
  key text [pk, note: 'Mục Parameters của domain, như min_password_length']
  value jsonb [not null]
  updated_by uuid [ref: > user_accounts.id]
  updated_at timestamptz [not null]
}

Table jobs {
  id bigint [pk, increment]
  kind text [not null]
  payload jsonb [not null]
  run_at timestamptz [not null]
  status text [not null, note: 'queued | running | done | failed']
  attempts smallint [not null, default: 0]
  locked_at timestamptz
  last_error text
  dedupe_key text [note: 'Unique khi còn queued hoặc running; tránh chạy một việc hai lần, như cộng phép một tháng (EC-038)']
  Note: 'Hàng đợi trong DB (ADR-0009). worker lấy việc bằng SELECT ... FOR UPDATE SKIP LOCKED'
}

// ---------------------------------------------------------------- M1: quy chế và câu hỏi gửi HR

Table policies {
  id uuid [pk]
  name text [not null]
  status text [not null, note: 'in_use | retired']
}

Table policy_versions {
  id uuid [pk]
  policy_id uuid [not null, ref: > policies.id]
  version_no integer [not null]
  effective_on date [not null]
  status text [not null, note: 'draft | published']
  published_by uuid [ref: > user_accounts.id]
  published_at timestamptz
  indexes {
    (policy_id, version_no) [unique]
  }
  Note: 'Unique (policy_id, effective_on) khi published: mỗi ngày tối đa một phiên bản hiệu lực (BR-192). Đã đăng thì không sửa: trigger'
}

Table policy_sections {
  id uuid [pk]
  policy_version_id uuid [not null, ref: > policy_versions.id]
  position smallint [not null]
  title text [not null]
  body text [not null]
  search tsvector [note: 'Cột sinh từ title và body; GIN index cho tìm kiếm (BR-193)']
}

Table faq_entries {
  id uuid [pk]
  question text [not null]
  answer text [not null]
  status text [not null, note: 'draft | published | hidden']
  needs_review boolean [not null, default: false, note: 'BR-194']
  policy_section_id uuid [ref: > policy_sections.id]
  created_by uuid [not null, ref: > user_accounts.id]
}

Table hr_questions {
  id uuid [pk]
  asker_account_id uuid [not null, ref: > user_accounts.id]
  body text [not null]
  source text [not null, note: 'form | chat']
  conversation_id uuid [ref: > conversations.id, note: 'M6: khi gửi từ chat (UC-020)']
  status text [not null, note: 'pending | answered']
  sent_at timestamptz [not null]
}

Table hr_question_messages {
  id uuid [pk]
  hr_question_id uuid [not null, ref: > hr_questions.id]
  author_account_id uuid [not null, ref: > user_accounts.id]
  body text [not null]
  created_at timestamptz [not null]
  Note: 'Chỉ ghi thêm: không sửa, không xóa'
}

// ---------------------------------------------------------------- M2: nghỉ phép

Table leave_types {
  id uuid [pk]
  name text [not null, unique]
  pay_mode text [not null, note: 'company_paid | social_insurance | unpaid']
  deducts_annual_leave boolean [not null]
  is_annual_leave boolean [not null, default: false, note: 'Unique khi true: đúng một loại Phép năm (BR-041)']
  max_days_per_request numeric(5,1)
  is_active boolean [not null, default: true]
}

Table leave_reasons {
  id uuid [pk]
  name text [not null]
  legal_days numeric(5,1)
  source text
  is_active boolean [not null, default: true]
}

Table leave_reason_types {
  leave_reason_id uuid [ref: > leave_reasons.id]
  leave_type_id uuid [ref: > leave_types.id]
  indexes {
    (leave_reason_id, leave_type_id) [pk]
  }
  Note: 'Loại nghỉ hợp lệ của từng lý do (BR-142)'
}

Table leave_requests {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  leave_type_id uuid [not null, ref: > leave_types.id]
  leave_reason_id uuid [not null, ref: > leave_reasons.id]
  details text [note: 'Nhạy cảm (BR-067)']
  start_date date [not null]
  start_half text [not null, note: 'am | pm']
  end_date date [not null]
  end_half text [not null, note: 'am | pm']
  half_slots int4range [not null, note: 'Cột sinh: buổi đầu tới buổi cuối, đánh số theo ngày và buổi']
  days numeric(5,1) [not null, note: 'BR-044']
  approver_id uuid [ref: > employees.id]
  delegate_approver_id uuid [ref: > employees.id, note: 'BR-149']
  recorded_by_account_id uuid [ref: > user_accounts.id, note: 'HR ghi đơn thay']
  handover_employee_id uuid [ref: > employees.id]
  batch_id uuid [note: 'Các đơn gửi trong một lần (BR-153)']
  ai_assisted boolean [not null, default: false]
  status text [not null, note: 'pending | awaiting | approved | rejected | cancelled']
  decision_reason text
  decided_by_account_id uuid [ref: > user_accounts.id]
  decided_at timestamptz
  Note: 'EXCLUDE (employee_id WITH =, half_slots WITH &&) WHERE status IN (pending, awaiting, approved): không chồng buổi (BR-045)'
}

Table leave_change_proposals {
  id uuid [pk]
  leave_request_id uuid [not null, ref: > leave_requests.id]
  start_date date [not null]
  start_half text [not null]
  end_date date [not null]
  end_half text [not null]
  message text
  proposed_by_account_id uuid [not null, ref: > user_accounts.id]
  proposed_at timestamptz [not null]
  response text [note: 'accepted | declined; trống khi chưa phản hồi']
  response_message text
  responded_at timestamptz
  Note: 'Giữ lịch sử mọi lần đề nghị (BR-150)'
}

Table leave_restriction_periods {
  id uuid [pk]
  name text [not null]
  period daterange [not null]
  whole_company boolean [not null]
  note text
}

Table leave_restriction_org_units {
  leave_restriction_period_id uuid [ref: > leave_restriction_periods.id]
  org_unit_id uuid [ref: > org_units.id]
  indexes {
    (leave_restriction_period_id, org_unit_id) [pk]
  }
}

Table leave_ledger_entries {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  entry_date date [not null]
  kind text [not null, note: 'accrual | usage | carryover_in | carryover_expired | adjustment | payout']
  days numeric(8,4) [not null, note: 'Có dấu; giữ đủ phần lẻ của 1/12 (BR-049)']
  leave_year smallint [not null]
  is_carryover boolean [not null, default: false]
  carryover_expires_on date
  accrual_month date [note: 'Ngày đầu tháng được cộng; unique (employee_id, accrual_month) khi kind = accrual (EC-038)']
  leave_request_id uuid [ref: > leave_requests.id]
  reason text
  created_by_account_id uuid [ref: > user_accounts.id]
  created_at timestamptz [not null]
  Note: 'Chỉ ghi thêm (BR-054): quyền DB không có UPDATE, DELETE. Số dư là tổng days'
}

Table work_calendar_days {
  day date [pk]
  kind text [not null, note: 'holiday | makeup_workday']
  name text
}

// ---------------------------------------------------------------- M3: chấm công

Table shifts {
  id uuid [pk]
  name text [not null, unique]
  starts_at time [not null]
  ends_at time [not null]
  break_starts_at time
  break_ends_at time
  break_counted boolean [not null, default: false]
  work_weekdays smallint[] [not null, note: '1 là thứ Hai tới 7 là chủ nhật']
  is_active boolean [not null, default: true]
}

Table shift_assignments {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  shift_id uuid [not null, ref: > shifts.id]
  valid daterange [not null]
  Note: 'EXCLUDE (employee_id WITH =, valid WITH &&). Không hở từ ngày vào làm (BR-070): domain'
}

Table punch_imports {
  id uuid [pk]
  file_name text [not null]
  imported_by_account_id uuid [not null, ref: > user_accounts.id]
  imported_at timestamptz [not null]
  saved_rows integer [not null]
  duplicate_rows integer [not null]
  skipped_rows jsonb [not null, note: 'Dòng bị bỏ qua kèm lý do']
}

Table punch_records {
  id bigint [pk, increment]
  punch_import_id uuid [not null, ref: > punch_imports.id]
  timeclock_code text [not null]
  punched_at timestamptz [not null]
  employee_id uuid [ref: > employees.id, note: 'Ghép theo mã chấm công lúc nhập']
  indexes {
    (timeclock_code, punched_at) [unique, note: 'Lượt chấm không trùng (BR-073)']
  }
}

Table attendance_days {
  employee_id uuid [ref: > employees.id]
  work_date date
  shift_id uuid [ref: > shifts.id]
  clock_in timestamptz
  clock_out timestamptz
  late_minutes smallint [not null, default: 0]
  early_leave_minutes smallint [not null, default: 0]
  work_units numeric(3,1) [not null, default: 0]
  leave_type_id uuid [ref: > leave_types.id]
  overtime_hours jsonb [not null, default: '{}', note: 'Giờ làm thêm theo loại ngày']
  night_hours numeric(4,2) [not null, default: 0]
  status text [not null, note: 'not_yet | day_off | full | on_leave | half_leave | missing_punch | absent_unresolved | absent_unexcused']
  needs_review boolean [not null, default: false]
  notified_at timestamptz [note: 'BR-216: mỗi ngày chỉ báo một lần']
  indexes {
    (employee_id, work_date) [pk]
  }
  Note: 'Bảng tính lại từ lượt chấm, đơn nghỉ, đơn làm thêm và giải trình; không có vòng đời riêng'
}

Table attendance_adjustments {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  work_date date [not null]
  proposed_clock_in timestamptz
  proposed_clock_out timestamptz
  reason text [not null]
  approver_id uuid [ref: > employees.id]
  status text [not null, note: 'pending | approved | rejected | cancelled']
  decision_reason text
  decided_by_account_id uuid [ref: > user_accounts.id]
  decided_at timestamptz
}

Table overtime_requests {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  work_date date [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  reason text
  approver_id uuid [ref: > employees.id]
  status text [not null, note: 'pending | approved | rejected | cancelled']
  decision_reason text
  decided_by_account_id uuid [ref: > user_accounts.id]
  decided_at timestamptz
  Note: 'CHECK (starts_at < ends_at). Giới hạn ngày, tháng, năm (BR-084): domain, trong transaction có khóa dòng employees'
}

Table attendance_periods {
  month date [pk, note: 'Ngày đầu tháng']
  status text [not null, note: 'open | closed']
  closed_by_account_id uuid [ref: > user_accounts.id]
  closed_at timestamptz
  reopen_reason text
}

Table monthly_timesheets {
  period_month date [ref: > attendance_periods.month]
  employee_id uuid [ref: > employees.id]
  standard_days numeric(4,1) [not null]
  worked_days numeric(4,1) [not null]
  paid_leave_days numeric(4,1) [not null]
  unpaid_leave_days numeric(4,1) [not null]
  paid_days numeric(4,1) [not null]
  late_count smallint [not null]
  overtime_hours jsonb [not null]
  night_hours numeric(5,2) [not null]
  indexes {
    (period_month, employee_id) [pk]
  }
  Note: 'Bản chụp khi chốt kỳ (BR-092); không đổi khi kỳ đã chốt'
}

// ---------------------------------------------------------------- M4: lương và phúc lợi

Table allowance_types {
  id uuid [pk]
  name text [not null, unique, note: 'BR-097']
  calc_mode text [not null, note: 'per_workday | monthly']
  tax_mode text [not null, note: 'taxable | exempt | exempt_up_to_cap']
  tax_exempt_cap numeric(15,0)
  is_active boolean [not null, default: true]
}

Table salary_records {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  valid daterange [not null]
  base_salary numeric(15,0) [not null, note: 'Đồng']
  insurance_salary numeric(15,0) [not null]
  reason text
  Note: 'EXCLUDE (employee_id WITH =, valid WITH &&). Không hở (BR-093) và mức sàn (BR-094, BR-096): domain'
}

Table salary_record_allowances {
  salary_record_id uuid [ref: > salary_records.id]
  allowance_type_id uuid [ref: > allowance_types.id]
  monthly_amount numeric(15,0) [not null]
  indexes {
    (salary_record_id, allowance_type_id) [pk, note: 'Mỗi loại tối đa một lần trong một bản ghi']
  }
}

Table dependents {
  id uuid [pk]
  employee_id uuid [not null, ref: > employees.id]
  full_name text [not null]
  relationship text [not null]
  date_of_birth date
  id_number text [note: 'Số định danh hoặc mã số thuế; nhạy cảm']
  start_month date [not null]
  end_month date
  Note: 'CHECK (end_month IS NULL OR end_month >= start_month). Không tính cho hai nhân viên cùng tháng (BR-099): domain'
}

Table payroll_parameters {
  id uuid [pk]
  key text [not null]
  valid_from date [not null]
  value jsonb [not null, note: 'Số hoặc biểu thuế dạng danh sách bậc']
  indexes {
    (key, valid_from) [unique]
  }
  Note: 'Giá trị đã dùng ở bảng lương đã chốt không sửa được (BR-123): domain'
}

Table payroll_runs {
  id uuid [pk]
  month date [not null, unique, ref: - attendance_periods.month]
  status text [not null, note: 'draft | stale | closed']
  calculated_by_account_id uuid [ref: > user_accounts.id]
  calculated_at timestamptz
  closed_by_account_id uuid [ref: > user_accounts.id]
  closed_at timestamptz
  Note: 'Chốt bằng UPDATE ... WHERE status = draft: hai thao tác chốt cùng lúc chỉ một thành công (EC-072)'
}

Table payslips {
  id uuid [pk]
  payroll_run_id uuid [not null, ref: > payroll_runs.id]
  employee_id uuid [not null, ref: > employees.id]
  standard_days numeric(4,1) [not null]
  paid_days numeric(4,1) [not null]
  dependents_count smallint [not null]
  inputs jsonb [not null, note: 'Mọi số liệu và tham số đã dùng, để đọc phiếu cũ không phải tính lại']
  gross_income numeric(15,0)
  taxable_income numeric(15,0)
  assessable_income numeric(15,0)
  personal_income_tax numeric(15,0)
  net_pay numeric(15,0)
  employer_contributions numeric(15,0)
  errors jsonb [not null, default: '[]']
  warnings jsonb [not null, default: '[]']
  indexes {
    (payroll_run_id, employee_id) [unique]
  }
}

Table payslip_lines {
  id uuid [pk]
  payslip_id uuid [not null, ref: > payslips.id]
  position smallint [not null]
  line_group text [not null, note: 'income | deduction | employer']
  name text [not null]
  amount numeric(15,0) [not null, note: 'Làm tròn tới đồng (BR-114)']
  taxable_amount numeric(15,0) [not null, default: 0]
  source text [not null, note: 'system | hr']
  reason text
}

// ---------------------------------------------------------------- M5: báo cáo

Table signals {
  id uuid [pk]
  signal_type text [not null]
  org_unit_id uuid [ref: > org_units.id, note: 'Trống là cả công ty']
  period_key text [not null, note: 'Kỳ của tín hiệu, như 2026-09 hoặc 2026-08-10/2026-11-09']
  figures jsonb [not null, note: 'Số liệu và phân rã tại lúc tính gần nhất']
  severity text [not null, note: 'high | normal']
  detected_at timestamptz [not null]
  last_calculated_at timestamptz [not null]
  data_in_correction boolean [not null, default: false]
  status text [not null, note: 'active | resolved']
  Note: 'Unique (signal_type, coalesce(org_unit_id), period_key) khi active (BR-172)'
}

Table signal_reactions {
  id uuid [pk]
  signal_id uuid [ref: > signals.id]
  insight_id uuid [ref: > insights.id]
  viewer_account_id uuid [not null, ref: > user_accounts.id]
  seen_at timestamptz
  following_since date
  closed_at timestamptz
  helpful boolean
  Note: 'CHECK đúng một trong signal_id, insight_id. Unique theo người xem và thẻ'
}

// ---------------------------------------------------------------- M6: AI

Table ai_outputs {
  id uuid [pk]
  created_at timestamptz [not null]
  feature text [not null, note: 'leave_coordinator | report_analyst | hr_assistant']
  entry_point text [not null, note: 'form | chat | notification | overview']
  situation text
  recipient_account_id uuid [not null, ref: > user_accounts.id]
  sent_data jsonb [not null, note: 'Chỉ trường cần cho tác vụ; không có trường ở BR-161']
  output jsonb
  check_result jsonb [note: 'BR-163']
  final_choice text
  leave_request_id uuid [ref: > leave_requests.id]
  action_proposal_id uuid [ref: > action_proposals.id]
  insight_id uuid [ref: > insights.id]
  conversation_turn_id uuid [ref: > conversation_turns.id]
}

Table action_proposals {
  id uuid [pk]
  action jsonb [not null, note: 'Thao tác đề xuất và tham số']
  confirmer_account_id uuid [not null, ref: > user_accounts.id]
  status text [not null, note: 'pending | confirmed | dismissed | expired']
  leave_request_id uuid [ref: > leave_requests.id]
  insight_id uuid [ref: > insights.id]
  created_at timestamptz [not null]
  decided_at timestamptz
}

Table insights {
  id uuid [pk]
  org_unit_id uuid [ref: > org_units.id, note: 'Trống là cả công ty']
  viewer_role text [not null]
  title text [not null]
  explanation text [not null]
  next_steps jsonb [not null]
  calculated_at timestamptz [not null]
}

Table insight_signals {
  insight_id uuid [ref: > insights.id]
  signal_id uuid [ref: > signals.id]
  indexes {
    (insight_id, signal_id) [pk]
  }
}

Table conversations {
  id uuid [pk]
  account_id uuid [not null, ref: > user_accounts.id, note: 'Chỉ người hỏi xem được (BR-203)']
  started_at timestamptz [not null]
  Note: 'Xóa sau assistant_retention_days ngày'
}

Table conversation_turns {
  id uuid [pk]
  conversation_id uuid [not null, ref: > conversations.id]
  position smallint [not null]
  question text [not null]
  screen_context jsonb
  tools_called jsonb [not null, default: '[]']
  created_at timestamptz [not null]
}
